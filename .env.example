# Copy to .env and adjust before deploy:
#   cp .env.example .env

# --- Cowrie (SSH / Telnet medium-interaction) ---
# Prefer 2222/2223 for class; avoid binding 22 without approval
COWRIE_SSH_HOST_PORT=2222
COWRIE_TELNET_HOST_PORT=2223
COWRIE_HOSTNAME=lab-srv01

# --- Conpot (ICS / SCADA low-interaction) ---
# High host ports avoid needing root. Scanners often hit real 502/161/102 —
# see README for privileged / firewall-redirect options.
CONPOT_MODBUS_HOST_PORT=5020
CONPOT_HTTP_HOST_PORT=8080
CONPOT_SNMP_HOST_PORT=1161
CONPOT_S7_HOST_PORT=1102
